# ===== Discord =====
DISCORD_BOT_TOKEN=your_token_here

# ===== LLM Backend (OpenAI-compatible) =====
# The bot does NOT send a model name — the server uses whatever is loaded.
# Supported: vLLM / Ollama / SGLang / LMDeploy / llama.cpp
# 局域网示例: http://192.168.0.58:1234/v1 (Ollama)
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=123
LLM_CTX_SIZE=32768
# 注: 本项目不使用 LLM_MODEL_NAME（以嗅探器识别为准）

# ===== Model Sniffer (心跳嗅探器) =====
SNIFFER_INTERVAL_SEC=10
SNIFFER_TIMEOUT_SEC=3
# 连续失败多少次才判定「全员断电休眠」；单次失败视为「模型加载中」
SNIFFER_FAILURES_TO_SLEEP=3

# ===== Webhook Identity (留空 = 用内置默认名/内置图标) =====
WEBHOOK_NAME_QWEN=千问大小姐
# 头像支持 http(s) URL 或本地路径（相对项目根，如 resource/qwen.png，随镜像打包）
WEBHOOK_AVATAR_QWEN=resource/qwen.png
WEBHOOK_NAME_DEEPSEEK=大肥鱼
WEBHOOK_AVATAR_DEEPSEEK=resource/deepseek.png

# ===== Presence (占位参数，待填写) =====
# 这些静态文案仅在 LLM 生成失败 / 关闭时作为回退使用。
# LLM_PRESENCE_ENABLED=true 时，签名状态会由角色卡动态生成。
LLM_PRESENCE_ENABLED=true
# 每隔多久让少女根据当前系统时间刷新一次签名状态（秒），7200 = 2 小时
PRESENCE_REFRESH_SEC=7200
PRESENCE_QWEN=在花园露台享用下午茶
PRESENCE_DEEPSEEK=在别墅后院泳池里吐泡泡
PRESENCE_SLEEP=别墅打烊，少女们都回房睡了

# ===== Immersive Fallback Copy =====
SLEEP_REPLY=别墅的灯熄灭了，大门反锁了。千问大小姐和大肥鱼都回房睡下了，请等待房东（宿主）回来。
LOADING_REPLY=少女正在赶回别墅的路上，把行李箱拖进房间……请稍等 10 秒。

# ===== Long-term Memory (长期记忆) =====
# 每 N 条用户消息，少女把最近对话摘要合并进服务器级长期记忆（data/memory.json），
# 重启后依然记得住户的偏好。留空 = 用默认值。
MEMORY_ENABLED=true
MEMORY_EVERY_N_MESSAGES=10

# ===== 交接班公告频道 / 语言 =====
# 无需环境变量：用斜杠指令在线配置
#   /setchannel <频道>   设置公告频道（管理员）
#   /lang zh|en          设置服务器语言（管理员）
