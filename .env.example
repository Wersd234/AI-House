# ===== Discord =====
DISCORD_BOT_TOKEN=your_token_here

# ===== LLM Backend (OpenAI-compatible) =====
# The bot does NOT send a model name — the server uses whatever is loaded.
# Supported: vLLM / Ollama / SGLang / LMDeploy / llama.cpp
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=123
LLM_CTX_SIZE=32768

# ===== Model Sniffer (心跳嗅探器) =====
SNIFFER_INTERVAL_SEC=10
SNIFFER_TIMEOUT_SEC=3

# ===== Webhook Identity (占位参数，待填写) =====
WEBHOOK_NAME_QWEN=<占位：如「千问大小姐」>
WEBHOOK_AVATAR_QWEN=<占位：持扇少女立绘 URL>
WEBHOOK_NAME_DEEPSEEK=<占位：如「大肥鱼」>
WEBHOOK_AVATAR_DEEPSEEK=<占位：鲸鱼娘立绘 URL>

# ===== Presence (占位参数，待填写) =====
PRESENCE_QWEN=<占位：如「正在嫌弃机箱进灰」>
PRESENCE_DEEPSEEK=<占位：如「正在水冷水池里吐泡泡」>
PRESENCE_SLEEP=<占位：如「机箱断电中，少女们都睡着了」>

# ===== Immersive Fallback Copy =====
SLEEP_REPLY=机箱电源已切断，合租屋门反锁了。千问大小姐和大肥鱼都在沉睡中，请等待房东（宿主）开机。
LOADING_REPLY=少女正在艰难地挤进显存里……显卡风扇呼呼转，请稍等 10 秒。
